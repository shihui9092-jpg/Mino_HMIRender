				float clampResult19 = clamp( dotResult16 , 0.0 , 1.0 );
				float smoothstepResult20 = smoothstep( _SmoothMin , _SmoothMax , clampResult19);
				

				float Alpha = ( smoothstepResult20 + 0.0 );
				float AlphaClipThreshold = 0.5;

