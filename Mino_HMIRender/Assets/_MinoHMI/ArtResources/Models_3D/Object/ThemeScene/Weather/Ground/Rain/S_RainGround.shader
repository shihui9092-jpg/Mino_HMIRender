				float fbrowsoffset80 = 1.0f / 8.0;
				// Speed of animation
				float fbspeed80 = _Time[ 1 ] * _RainSpeed;
				// UV Tiling (col and row offset)
				float2 fbtiling80 = float2(fbcolsoffset80, fbrowsoffset80);
				// UV Offset - calculate current tile linear index, and convert it to (X * coloffset, Y * rowoffset)
				// Calculate current tile linear index
				float fbcurrenttileindex80 = floor( fmod( fbspeed80 + 0.0, fbtotaltiles80) );
				fbcurrenttileindex80 += ( fbcurrenttileindex80 < 0) ? fbtotaltiles80 : 0;
				// Obtain Offset X coordinate from current tile linear index
				float fblinearindextox80 = round ( fmod ( fbcurrenttileindex80, 8.0 ) );
				// Multiply Offset X by coloffset
				float fboffsetx80 = fblinearindextox80 * fbcolsoffset80;
				// Obtain Offset Y coordinate from current tile linear index
				float fblinearindextoy80 = round( fmod( ( fbcurrenttileindex80 - fblinearindextox80 ) / 8.0, 8.0 ) );
				// Reverse Y to get tiles from Top to Bottom
				fblinearindextoy80 = (int)(8.0-1) - fblinearindextoy80;
				// Multiply Offset Y by rowoffset
				float fboffsety80 = fblinearindextoy80 * fbrowsoffset80;
				// UV Offset
				float2 fboffset80 = float2(fboffsetx80, fboffsety80);
				// Flipbook UV
				half2 fbuv80 = frac( ( (WorldPosition).xz * _RainTilling ) ) * fbtiling80 + fboffset80;
				// *** END Flipbook UV Animation vars ***
				int flipbookFrame80 = ( ( int )fbcurrenttileindex80);
				float RainControl190 = _RainControl;
				float3 unpack79 = UnpackNormalScale( tex2D( _RainTex, fbuv80 ), ( _RainIntensity * RainControl190 ) );
				unpack79.z = lerp( 1, unpack79.z, saturate(( _RainIntensity * RainControl190 )) );
				float3 RainNormal107 = unpack79;
				float3 ase_worldTangent = IN.ase_texcoord4.xyz;
				float3 ase_worldNormal = IN.ase_texcoord5.xyz;
				float3 ase_worldBitangent = IN.ase_texcoord6.xyz;
				float3 tanToWorld0 = float3( ase_worldTangent.x, ase_worldBitangent.x, ase_worldNormal.x );
				float3 tanToWorld1 = float3( ase_worldTangent.y, ase_worldBitangent.y, ase_worldNormal.y );
				float3 tanToWorld2 = float3( ase_worldTangent.z, ase_worldBitangent.z, ase_worldNormal.z );
				float3 tanNormal168 = RainNormal107;
				float3 worldNormal168 = float3(dot(tanToWorld0,tanNormal168), dot(tanToWorld1,tanNormal168), dot(tanToWorld2,tanNormal168));
				float4 CubeMap171 = ( texCUBElod( _CubeMap, float4( reflect( -( ase_worldViewDir * float3(1,1,1) ) , worldNormal168 ), 0.0) ) * _Emission * float4( _Color.rgb , 0.0 ) );
				
				float dotResult131 = dot( ase_worldNormal , ase_worldViewDir );
				float clampResult134 = clamp( dotResult131 , 0.0 , 1.0 );
				float smoothstepResult135 = smoothstep( _SmoothMin , _SmoothMax , clampResult134);
				float Alpha137 = pow( smoothstepResult135 , _PowerSmooth );
				
				float3 BakedAlbedo = 0;
				float3 BakedEmission = 0;
				float3 Color = CubeMap171.rgb;
